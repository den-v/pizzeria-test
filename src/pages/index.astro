---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import OpenStatus from '../components/OpenStatus.astro';
import Offers from '../components/Offers.astro';
import Reviews from '../components/Reviews.astro';
import HoursTable from '../components/HoursTable.astro';
import Holidays from '../components/Holidays.astro';
import Labels from '../components/Labels.astro';
import { CATEGORY_INFO, formatPrice, getInfo, getPizzas } from '../lib/site';

const info = await getInfo();
const pizzas = await getPizzas();
const potw = info.pizzaOfTheWeek ? await getEntry(info.pizzaOfTheWeek) : undefined;

// Hero: the first available pizza of each category.
const heroPizzas = (Object.keys(CATEGORY_INFO) as (keyof typeof CATEGORY_INFO)[])
  .map((c) => pizzas.find((p) => p.data.category === c && p.data.available) ?? pizzas.find((p) => p.data.category === c))
  .filter((p) => p !== undefined);

const categories = (Object.entries(CATEGORY_INFO) as [keyof typeof CATEGORY_INFO, (typeof CATEGORY_INFO)[keyof typeof CATEGORY_INFO]][]).map(
  ([key, meta]) => ({ key, ...meta, items: pizzas.filter((p) => p.data.category === key) }),
);
const tel = info.phone.replace(/[^+\d]/g, '');
---

<Base>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-text">
        <p class="eyebrow">Pizzeria · Lviv · since 2014</p>
        <h1 class="hero-text-title">{info.name}</h1>
        <p class="lead">{info.tagline}</p>
        <OpenStatus />
        <div class="actions">
          <a class="button" href="/menu/">See the menu </a>
          <a class="button button--ghost" href={`tel:${tel}`}>Call me {info.phone}</a>
        </div>
      </div>
      <div class="hero-art" aria-hidden="true">
        {
          heroPizzas.map((p, i) => (
            <div class={`plate plate--${i}`}>
              <Image src={p.data.photo} alt="" widths={[360, 640]} sizes="(max-width: 50rem) 60vw, 420px" loading={i === 0 ? 'eager' : 'lazy'} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <Offers />

  {
    potw && (
      <section class="section potw" aria-labelledby="potw-title">
        <div class="container potw-inner">
          <div class="potw-photo">
            <Image src={potw.data.photo} alt={potw.data.photoAlt || potw.data.name} widths={[500, 900]} sizes="(max-width: 50rem) 100vw, 560px" />
            <span class="stamp">
              Pizza
              <br />
              of the week
            </span>
          </div>
          <div class="potw-text">
            <p class="eyebrow">Pizza of the week</p>
            <h2 id="potw-title">{potw.data.name}</h2>
            <Labels labels={potw.data.labels} soldOut={!potw.data.available} />
            {info.pizzaOfTheWeekNote && <p class="note">{info.pizzaOfTheWeekNote}</p>}
            <p>{potw.data.description}</p>
            <p class="potw-prices">
              <span>
                30 cm <strong>{formatPrice(potw.data.price30)}</strong>
              </span>
              <span>
                40 cm <strong>{formatPrice(potw.data.price40)}</strong>
              </span>
            </p>
            <a class="button" href={`/menu/${potw.id}/`}>
              More about {potw.data.name}
            </a>
          </div>
        </div>
      </section>
    )
  }

  <section class="section menu-teaser" aria-labelledby="menu-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Our menu</p>
        <h2 id="menu-title">{pizzas.length} pizzas, one red oven</h2>
        <p>Dough rested for 48 hours, baked at 450 °C in ninety seconds. Every pizza comes in 30 cm and 40 cm.</p>
      </div>
      <ul class="cats">
        {
          categories.map((c) => (
            <li>
              <a class="cat" href={`/menu/#${c.key}`}>
                <h3>{c.title}</h3>
                <p>{c.blurb}</p>
                <p class="cat-names">{c.items.map((p) => p.data.name).join(' · ')}</p>
                <span class="cat-go" aria-hidden="true">
                  →
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Reviews />

  <section class="section visit" aria-labelledby="visit-title">
    <div class="container visit-inner">
      <div>
        <p class="eyebrow">Come by</p>
        <h2 id="visit-title">Find us in the old town</h2>
        <address class="addr">
          {info.address}<br />{info.city}
        </address>
        <div class="actions">
          <a class="button" href={info.mapUrl} target="_blank" rel="noopener">Open in maps ↗</a>
          <a class="button button--ghost" href={`tel:${tel}`}>{info.phone}</a>
        </div>
        <Holidays />
      </div>
      <div class="hours-card">
        <div class="hours-head">
          <h3>Opening hours</h3>
          <OpenStatus compact />
        </div>
        <HoursTable />
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-xl) var(--space-2xl);
    background:
      radial-gradient(circle at 85% 30%, rgb(224 154 44 / 0.22), transparent 45%),
      radial-gradient(circle at 10% 90%, rgb(179 48 28 / 0.12), transparent 40%);
  }
  .hero-inner {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
    grid-template-columns: 1.05fr 1fr;
  }
  .hero-text {
    display: grid;
    gap: var(--space-m);
    justify-items: start;
  }
  .hero h1 {
    font-size: clamp(3.2rem, 9vw, 6.5rem);
    color: var(--red);
  }
  .lead {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.5vw, 1.75rem);
    line-height: 1.3;
    max-inline-size: 22ch;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
  }
  .hero-art {
    position: relative;
    aspect-ratio: 1;
    max-inline-size: 34rem;
    inline-size: 100%;
    justify-self: center;
  }
  .plate {
    position: absolute;
    border-radius: 50%;
    overflow: hidden;
    box-shadow: 0 24px 50px -18px rgb(43 28 20 / 0.55);
    aspect-ratio: 1;
  }
  .plate img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    transform: scale(1.32);
  }
  .plate--0 {
    inline-size: 72%;
    inset-block-start: 4%;
    inset-inline-start: 2%;
    z-index: 2;
    animation: spin 90s linear infinite;
  }
  .plate--1 {
    inline-size: 44%;
    inset-block-end: 0;
    inset-inline-end: 0;
    z-index: 3;
    animation: spin 120s linear infinite reverse;
  }
  .plate--2 {
    inline-size: 34%;
    inset-block-start: 0;
    inset-inline-end: 4%;
    z-index: 1;
  }
  @keyframes spin {
    to {
      rotate: 360deg;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .plate {
      animation: none;
    }
  }
  @media (max-width: 50rem) {
    .hero-inner {
      grid-template-columns: 1fr;
    }
    .hero-art {
      max-inline-size: 24rem;
    }
  }

  .potw {
    background: var(--char);
    color: #f3e6d6;
  }
  .potw .eyebrow {
    color: var(--gold);
  }
  .potw-inner {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
    grid-template-columns: 1fr 1fr;
  }
  .potw-photo {
    position: relative;
  }
  .potw-photo img {
    border-radius: var(--radius);
    inline-size: 100%;
  }
  .stamp {
    position: absolute;
    inset-block-start: -1.2rem;
    inset-inline-end: -0.6rem;
    display: grid;
    place-items: center;
    inline-size: 7rem;
    block-size: 7rem;
    border-radius: 50%;
    background: var(--gold);
    color: var(--char);
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1.05;
    text-align: center;
    rotate: 12deg;
    box-shadow: 0 10px 24px -8px rgb(0 0 0 / 0.5);
  }
  .potw-text {
    display: grid;
    gap: var(--space-m);
    justify-items: start;
  }
  .potw-text h2 {
    color: #fff;
    font-size: clamp(2.4rem, 5vw, 3.6rem);
  }
  .note {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-style: italic;
    color: var(--gold-soft);
    border-inline-start: 3px solid var(--gold);
    padding-inline-start: var(--space-m);
  }
  .potw-prices {
    display: flex;
    gap: var(--space-l);
    color: #c9b6a2;
  }
  .potw-prices strong {
    color: #fff;
    font-size: 1.3rem;
    margin-inline-start: 0.3rem;
  }
  @media (max-width: 50rem) {
    .potw-inner {
      grid-template-columns: 1fr;
    }
    .stamp {
      inset-inline-end: 0.5rem;
    }
  }

  .cats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
  }
  .cat {
    position: relative;
    display: grid;
    gap: var(--space-xs);
    block-size: 100%;
    padding: var(--space-l);
    border-radius: var(--radius);
    background: var(--paper);
    border: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
    transition: border-color 0.2s, transform 0.2s;
  }
  .cat:hover {
    color: var(--ink);
    border-color: var(--red);
    transform: translateY(-2px);
  }
  .cat p {
    color: var(--muted);
  }
  .cat .cat-names {
    font-size: 0.9rem;
    color: var(--red-deep);
    font-weight: 500;
  }
  .cat-go {
    position: absolute;
    inset-block-start: var(--space-l);
    inset-inline-end: var(--space-l);
    font-size: 1.4rem;
    color: var(--red);
  }

  .visit-inner {
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: 1.1fr 1fr;
    align-items: start;
  }
  .visit-inner > div:first-child {
    display: grid;
    gap: var(--space-m);
  }
  .addr {
    font-style: normal;
    font-size: 1.25rem;
  }
  .hours-card {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--space-l);
    box-shadow: var(--shadow);
  }
  .hours-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-block-end: var(--space-s);
  }
  @media (max-width: 50rem) {
    .visit-inner {
      grid-template-columns: 1fr;
    }
  }

  .hero-text-title {
    color: var(--basil);
    display: grid;
  }
</style>
